[user]
  email = deepakchauhan19feb@gmail.com
  name = MidStein
[init]
  defaultBranch = main
[core]
  pager = delta
[alias]
  graph = log --all --decorate --graph --oneline
[interactive]
  diffFilter = delta --color-only
[delta]
  navigate = true
  light = true
  line-numbers = true
[merge]
  conflictStyle = diff3
  tool = nvimdiff
[diff]
  colorMoved = default
  algorithm = histogram
  tool = nvimdiff
[commit]
  verbose = true
[difftool "nvimdiff"]
  cmd = nvim -d -c 'wincmd l' -c 'cd "$GIT_PREFIX"' "$LOCAL" "$REMOTE"
